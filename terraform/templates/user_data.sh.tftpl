#!/bin/bash
# cloud-init lo ejecuta una vez por instancia (nueva o restaurada desde un snapshot).
set -euo pipefail

apt-get update -y
apt-get install -y python3-pip git software-properties-common
add-apt-repository --yes --update ppa:ansible/ansible
apt-get install -y ansible

# Configuración de pz-provision: valores de Terraform, sin secretos.
cat > /etc/pz-provision.env <<'ENV'
REPO_URL=${repo_url}
REPO_BRANCH=${repo_branch}
REPO_COMMIT=${repo_commit}
REPO_FOLLOW_BRANCH=${repo_follow_branch}
REPO_DIR=${repo_dir}
PZ_SERVER_NAME=${server_name}
PZ_JAVA_XMX_MB=${java_xmx_mb}
PZ_HOST_OVERHEAD_MB=${host_overhead_mb}
PZ_WAIT_FOR_CONFIG=${wait_for_config}
PZ_AUTO_SNAPSHOT_ENABLED=${auto_backup_enabled}
PZ_SNAPSHOT_TIME_UTC=${backup_time_utc}
PZ_SNAPSHOT_RETAIN=${backup_retain_count}
ENV
chmod 0644 /etc/pz-provision.env

echo '${provision_script_b64}' | base64 -d > /usr/local/sbin/pz-provision
chmod 0755 /usr/local/sbin/pz-provision

/usr/local/sbin/pz-provision
