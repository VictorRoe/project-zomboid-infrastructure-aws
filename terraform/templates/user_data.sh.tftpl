#!/bin/bash
set -e

apt-get update -y
apt-get install -y python3-pip git software-properties-common
add-apt-repository --yes --update ppa:ansible/ansible
apt-get install -y ansible

# On a disk restored from a snapshot the checkout already exists. Git runs as
# ubuntu because it refuses repos owned by another user ("dubious ownership").
if [ -d ${repo_dir}/.git ]; then
  runuser -u ubuntu -- git -C ${repo_dir} fetch origin ${repo_branch}
  runuser -u ubuntu -- git -C ${repo_dir} reset --hard origin/${repo_branch}
else
  mkdir -p ${repo_dir}
  git clone --branch ${repo_branch} ${repo_url} ${repo_dir}
  chown -R ubuntu:ubuntu ${repo_dir}
fi

su - ubuntu -c "cd ${repo_dir}/playbook && ansible-playbook -i inventory.ini project-zomboid-server-install.yml -e pz_server_name=${server_name}"
